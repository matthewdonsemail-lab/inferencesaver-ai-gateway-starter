{
  "name": "inferencesaver-ai-gateway-starter",
  "version": "0.1.0",
  "private": true,
  "description": "Credential-safe InferenceSaver integration starter + media model capability aggregator + API",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "sync-models": "tsx src/sync-models.ts",
    "sync-media-capabilities": "tsx src/media-capabilities/sync.ts",
    "media-capabilities:aggregate": "tsx src/media-capabilities/aggregator.ts",
    "media-capabilities:validate": "tsx src/media-capabilities/validate.ts",
    "media-capabilities:serve": "tsx src/media-capabilities/server.ts",
    "media-capabilities:generate-static-api": "tsx src/media-capabilities/generate-static-api.ts",
    "media-capabilities:build": "npm run media-capabilities:aggregate && npm run media-capabilities:generate-static-api",
    "example:openai": "tsx src/examples-openai.ts",
    "example:anthropic": "tsx src/examples-anthropic.ts",
    "example:ai-sdk": "tsx src/examples-ai-sdk.ts",
    "smoke": "tsx src/smoke.ts",
    "test": "tsx --test test/**/*.test.ts",
    "modelsdev:export": "tsx src/modelsdev-export.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.25",
    "@anthropic-ai/sdk": "0.67.0",
    "ai": "7.0.55",
    "openai": "6.16.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}